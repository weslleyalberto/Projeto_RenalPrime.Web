@{
    string currentController = ViewContext.RouteData.Values["action"].ToString();
    const string colorAtual = "background:var(--madeira-escura);color:white;";
    string color = String.Empty;
    if (currentController == "Index")
    {
        color = colorAtual;

    }
    else if (currentController == "BCM")
    {
        color = colorAtual;
    }
    else if (currentController == "Dialog_Plus")
    {
        color = colorAtual;
    }
    else if (currentController == "NossaClinica")
    {
        color = colorAtual;
    }
    else if (currentController == "CorpoClinico")
    {
        color = colorAtual;
    }
    else if (currentController == "Mobissom")
    {
        color = colorAtual;
    }
    else if (currentController == "Hemodiafiltracao")
    {
        color = colorAtual;
    }
    else if (currentController == "Contatos")
    {
        color = colorAtual;
    }
    else if (currentController == "TransplanteRenal")
    {
        color = colorAtual;
    }
    else if (currentController == "DialisePeritoneal")
    {
        color = colorAtual;
    }

}

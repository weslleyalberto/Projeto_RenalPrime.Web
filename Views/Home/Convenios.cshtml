@{
    ViewData["Title"] = "Convênios";
}
<style>
    .list-unstyled li {
        color: #e6e6e6;
    }
    .fw-bold {
        color: #FFFFFF !important;
    }

    /* Estilo do container verde com a marca d'água */
    .box-convenios {
        background-color: #064236;
        position: relative;
        overflow: hidden; /* Evita que a imagem vaze da caixa */
        z-index: 1;
    }

    /* Pseudo-elemento para a logo no fundo */
    .box-convenios::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 15%; /* Posiciona a logo um pouco cortada na esquerda, como na sua imagem base */
        transform: translateY(-50%);
        width: 60%; /* Controle do tamanho da marca d'água */
        height: 100%;
        
        /* IMPORTANTE: Substitua o link abaixo pelo caminho da sua logo real (ex: url('/images/logo-branca.png')) */
        background-image: url('/images/logo/img28.png'); 
        
        background-repeat: no-repeat;
        background-position: left center;
        background-size: contain;
        opacity: 0.05; /* Controle a transparência aqui (0.05 é bem suave) */
        z-index: -1; /* Mantém a imagem atrás do texto */
    }
</style>


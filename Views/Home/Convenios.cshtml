@{
    ViewData["Title"] = "Convênios";
}


<header class="site-header d-flex  section-header-nav bg-renal bg-position-top-right">
    <div class="container">
        <div class="row resposiva-container">
            <div class="col-md-12 col-xxl-12" id="menu-navegacao" data-aos="fade-right">
                <h5 class="text-start renal-title">Renal Prime</h5>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Início</a></li>

                        <li class="breadcrumb-item active" aria-current="page">
                            Convênios

                        </li>
                    </ol>
                </nav>

                <div class="line"></div>
                <h2>Convênios</h2>
                <h4>
                   Confira o rol de convênios aceitos

                </h4>
                <div class="grid-person mt-5">
                    <div class="grid-wrapper">
                        <div class="row-grid">
                            <ul class="owl-carousel" style="display:flex;flex-wrap:wrap;flex-basis:150px;list-style:none;justify-content:center">
                                <li>
                                    <img src="~/images/convenios-logo/otorrino-fusma.png" alt="Fusma"
                                         title="Fusma" width="150" height="155" style="max-width:170px" data-aos="flip-left"/>
                                </li>
                                <li>
                                    <img src="~/images/convenios-logo/unnamed.png" alt="Fusex"
                                         title="Fusex" width="150" style="max-width:150px" data-aos="flip-left" />
                                </li>
                                <li>
                                    <img src="~/images/convenios-logo/gdf-saude.png"
                                         alt="GDF SAúde"
                                         title="GDF Saúde" width="150" style="max-width:150px" data-aos="flip-left" />
                                </li>
                                <li style="display:flex;align-items: center;">
                                    <img src="~/images/convenios-logo/geap-saude-logo-E9F617CC68-seeklogo.com.png"
                                         alt="Geap-saude" class="mt-4" data-aos="flip-left"
                                         title="Geap-saude" width="150" height="100" style="max-width:150px;max-height:100"  />
                                </li>
                               
                                <li style="display:flex;align-items: center;" class="mt-4">
                                    <img src="~/images/convenios-logo/Luminar-horizontal-cor.png" alt="Luminar Saúde"
                                         title="Luminar Saúde" width="240" height="100" style="max-width:240px" data-aos="flip-left" />
                                </li>
                                <li style="display:flex;align-items: center;" class="mt-3">
                                    <img src="~/images/convenios-logo/logo_saude_brb.png" alt="Saúde BRB"
                                         title="Saúde BRB" width="200" height="100" style="max-width:200px" data-aos="flip-left" />
                                </li>
                              
                            </ul>
                        </div>
                    </div>
                </div>
              
            </div>

            

        </div>
    </div>
</header>

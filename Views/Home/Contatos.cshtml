@{
    ViewData["Title"] = "Contatos";
}

<header class="site-header d-flex flex-column justify-content-center  section-header-nav bg-renal bg-position-top-left">

    <div class="container">
        <div class="row resposiva-container resposiva-container-row-reverse">
            <h5 class="text-end renal-title">Renal Prime</h5>
            <div class="col-md-6 container-contato-altura" id="menu-navegacao" data-aos="fade-right">

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Início</a></li>

                        <li class="breadcrumb-item active" aria-current="page">  Localização</li>
                    </ol>
                </nav>

                <div class="line"></div>
                <h2>
                    Localização
                </h2>
                <h4>Privilegiada</h4>
                <h6>
                    A Clínica Renal Prime está situada no Centro Clínico Cléo Octávio, na Asa Norte, em uma região central e de fácil acesso em Brasília.

                </h6>
                <div class="container-localizacao">
                    <div class="container-localizacao__icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div class="container-localizacao__text">
                        <div class="container-localizacao__text__title">
                            <a href="https://maps.app.goo.gl/M18JaWNkfnUgMVgv8"
                               title="Localização Renal Prime" target="_blank">
                                Google Maps
                            </a>

                        </div>
                        <div class="container-localizacao__text__endereco">
                            SMHN, Quadra 02, Bloco B, Salas
                            701 a 703 e 705 a 711.
                        </div>
                    </div>
                </div>
            </div>
            <div class="container col-md-6" style="position:relative" data-aos="fade-left">
                <img src="~/images/img_person/img119.jpg" width="100%" height="400" style="border-radius:7px" />
                <div class="container-vagas-contato" data-aos="flip-up">
                    <h6 style="width:80%;font-size:1.2em">10 vagas de garagem para nossos pacientes!</h6>
                </div>

            </div>

        </div>
    </div>
</header>

<section class="section-bg padding-top-container-header bg-renal bg-position-top-right" id="menu-navegacao">
    <div class="container ">
        <div class="row">

            <h5 class="text-start renal-title">Renal Prime</h5>
            <div class="col-lg-12 col-md-12">

                <div class="line"></div>
                <h2 class="pb-2">
                    Venha Conhecer
                </h2>
                <h4>Nossas Instalações</h4>

            </div>
            <div class="col-lg-7 col-12" data-aos="fade-up-right">
                <h6 id="body-subtitle-localizacao">
                    Convidamos você a conhecer de perto a Clínica Renal Prime e a descobrir como nosso ambiente acolhedor e
                    nossos serviços de excelência podem transformar a experiência de tratamento renal. Aqui, cada detalhe foi
                    cuidadosamente pensado para proporcionar o máximo conforto e bem-estar aos nossos pacientes, sempre com o
                    compromisso de oferecer um atendimento humanizado e ético. Nossa equipe está preparada para cuidar de cada
                    paciente com dedicação e respeito, priorizando a saúde e a qualidade de vida. Venha nos visitar e veja como
                    podemos fazer a diferença no seu cuidado.
                </h6>

            </div>


            <div class="col-lg-5 col-md-12 mx-auto mt-5 mt-lg-0" id="container-master-contato" data-aos="fade-up-left">
                <div class="container-contatos">
                    <div class="container-contato-title">
                        <h6>Contatos</h6>
                    </div>
                    <style>
                        .container-contatos__telefone__icons svg {
                            color:red;
                            
                        }
                    </style>
                    <div class="container-contatos__telefones">
